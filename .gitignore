# Byte-compiled and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Distribution and packaging
build/
dist/
*.egg-info/

# Secrets. The gate checks for credential material in tracked files, but the
# right defense is for the material never to be written here in the first
# place.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# Local scratch
*.log
.DS_Store
Thumbs.db
